# Обязателен: ключ шифрования файлового keyring-бэкенда (хранит Yandex-токен
# в /data/keyring.enc внутри контейнера — системного keyring там нет).
# Сгенерировать: openssl rand -hex 32
SOUNDSAVE_KEYRING_SECRET=

# Порт, на котором фронтенд будет доступен на хосте.
FRONTEND_PORT=3000

# Обязателен: папка на хосте для скачанных mp3 — видна напрямую в проводнике/Finder.
# Windows: C:/Users/<you>/Music/SoundSave
# macOS/Linux: /home/<you>/Music/SoundSave (или $HOME/Music/SoundSave)
SOUNDSAVE_MUSIC_DIR=
